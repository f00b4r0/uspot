#!/usr/bin/ucode

let ubus = require('ubus').connect();
let uci = require('uci').cursor();

function restart() {
	system('/etc/init.d/uspotfilter restart');
	system('/etc/init.d/uspot restart');
	system('/etc/init.d/uhttpd restart');
}

function interfaces() {
	let interfaces = [];
	uci.foreach('uspot', 'uspot', (d) => {
		if (!d[".anonymous"])
			push(interfaces, d[".name"]);
	});
	return uniq(interfaces);
}

function usage() {
printf("Usage: uspot <CMD>
CMD in:
	debugon
	debugoff
	clients
	log
	restart
");
}

switch(ARGV[0]) {
case 'dumpfilter':
	for (let interface in interfaces()) {
		let clients = ubus.call('uspotfilter', 'client_list', { interface });
		printf("%s:\n", interface);
		printf('%.J\n', clients);
	}
	break;
case 'dumpuspot':
	for (let interface in interfaces()) {
		let clients = ubus.call('uspot', 'client_get', { uspot: interface });
		printf("%s:\n", interface);
		printf('%.J\n', clients);
	}
	break;
case 'clients':
	for (let interface in interfaces()) {
		let cfilter = ubus.call('uspotfilter', 'client_list', { interface });
		let cuspot = ubus.call('uspot', 'client_get', { uspot: interface });
		let res = {};
		let t = time();

		printf("%s:\n", interface);
		for (let c, val in cfilter) {
			if (val.state != null) {
				res[c] = {
					status: val.state ? 'Authenticated' : 'Garden',
					time: val.data.connect ? t - val.data.connect : 0,
					idle: val.idle_since ? t - val.idle_since : 0,
					lost: val.lost_since ? t - val.lost_since : 0,
					ip4addr: val.ip4addr || '',
					ip6addr: val.ip6addr || '',
					... cuspot?.[c] || {},
				};
			}
		}
		printf('%.J\n', res);
	}
	break;
case 'restart':
	restart();
	break;
case 'log':
	system('logread -e uspot');
	break;
case 'debugon':
case 'debugoff':
	for (let interface in interfaces())
		uci.set('uspot', interface, 'debug', 'debugon'==ARGV[0]);
	uci.commit();
	restart();
	break;
default:
	usage();
	break;
}
